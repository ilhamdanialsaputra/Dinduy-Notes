<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sama seperti backup_rules.xml, untuk cadangan cloud dan pindah perangkat. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secure" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
